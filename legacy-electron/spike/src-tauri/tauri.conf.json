{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "SubTake Shell Spike",
	"version": "0.1.0",
	"identifier": "local.subtake.shellspike",
	"build": {
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [],
		"security": {
			"capabilities": [
				{
					"identifier": "spike-local",
					"windows": ["main"],
					"remote": {
						"urls": ["http://127.0.0.1:*/"]
					},
					"permissions": ["core:default", "allow-show-hud"]
				}
			]
		}
	},
	"bundle": {
		"active": false,
		"icon": ["../../public/rec-button.png"]
	}
}
