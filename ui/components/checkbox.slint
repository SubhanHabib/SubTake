import { Theme } from "../theme.slint";
export component Checkbox inherits Rectangle {
    in property <string> text;
    in property <string> label:root.text;
    in-out property <bool> checked:false;
    in-out property <bool> indeterminate:false;
    in property <bool> enabled:true;
    callback toggled(bool);
    public function activate() {if root.enabled {root.indeterminate=false;root.checked=!root.checked;root.toggled(root.checked);}}
    height:Theme.control-regular;min-width:root.text=="" ? 18px : caption.preferred-width+26px;
    vertical-stretch:0;opacity:root.enabled ? 1 : Theme.disabled-opacity;
    Rectangle {x:0px;y:(parent.height - 18px)/2;width:18px;height:18px;border-radius:4px;background:root.checked || root.indeterminate ? Theme.blue : Theme.input;border-width:key.has-focus ? Theme.focus-width : Theme.border-width;border-color:key.has-focus ? Theme.blue : Theme.border;
        if root.checked && !root.indeterminate: Image {x:2px;y:2px;width:14px;height:14px;source:@image-url("../../assets/icons/Check-regular.svg");colorize:Theme.on-accent;}
        if root.indeterminate: Rectangle {x:4px;y:8px;width:10px;height:2px;background:Theme.on-accent;}
    }
    caption:=Text {x:26px;width:parent.width - self.x;height:parent.height;text:root.text;color:Theme.text;font-size:Theme.font-control;vertical-alignment:center;overflow:elide;}
    TouchArea {enabled:root.enabled;mouse-cursor:pointer;clicked=>{key.focus();root.activate();}}
    key:=FocusScope {enabled:root.enabled;width:0px;height:0px;key-pressed(e)=>{if e.text==" " {root.activate();return accept;}return reject;}}
    forward-focus:key;accessible-role:checkbox;accessible-label:root.label;accessible-enabled:root.enabled;accessible-checked:root.checked;
    accessible-action-default=>{root.activate();}
}
