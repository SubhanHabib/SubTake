import { Theme } from "../theme.slint";
export enum TextRole { body, muted, heading, caption }
export component Label inherits Text {
    in property <TextRole> role:body;
    color:root.role==TextRole.muted || root.role==TextRole.caption ? Theme.muted : Theme.text;
    font-family:Theme.font-family;
    font-size:root.role==TextRole.heading ? Theme.font-heading : root.role==TextRole.caption ? Theme.font-small : Theme.font-control;
    font-weight:root.role==TextRole.heading ? 600 : 400;
    vertical-alignment:center;
}
