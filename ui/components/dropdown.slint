import { Theme, ControlSize } from "../theme.slint";
import { ScrollArea } from "scroll-area.slint";
import { Panel, SurfaceVariant } from "panel.slint";
export component Dropdown inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index:0;
    in property <string> label:"Choose an option";
    in property <string> placeholder:"Choose an option";
    in property <bool> enabled:true;
    in property <ControlSize> size:regular;
    out property <string> current-value:root.current-index>=0 && root.current-index<root.model.length ? root.model[root.current-index] : "";
    out property <bool> expanded:false;
    private property <int> highlighted:0;
    callback selected(string);
    height:Theme.control-height;
    min-width:60px;vertical-stretch:0;
    background:Theme.surface;border-radius:Theme.radius-control;border-width:key.has-focus || root.expanded ? Theme.focus-width : Theme.border-width;border-color:key.has-focus || root.expanded ? Theme.blue : Theme.border;
    opacity:root.enabled && root.model.length>0 ? 1 : Theme.disabled-opacity;
    public function open() {if root.enabled && root.model.length>0 {root.highlighted=clamp(root.current-index,0,root.model.length - 1);popup.show();}}
    public function choose(index:int) {if root.enabled && index>=0 && index<root.model.length {root.current-index=index;root.selected(root.model[index]);popup.close();key.focus();}}
    function move-highlight(delta:int) {root.highlighted=clamp(root.highlighted+delta,0,root.model.length - 1);}
    changed model => {if root.expanded {popup.close();}root.highlighted=clamp(root.current-index,0,max(0,root.model.length - 1));}
    changed enabled => {if !root.enabled {popup.close();}}
    Text {x:10px;width:parent.width - 36px;height:parent.height;text:root.current-value!="" ? root.current-value : root.placeholder;color:root.current-value!="" ? Theme.text : Theme.muted;font-size:Theme.font-control;vertical-alignment:center;overflow:elide;}
    Image {x:parent.width - 24px;y:(parent.height - 14px)/2;width:14px;height:14px;source:@image-url("../../assets/icons/CaretDown-regular.svg");colorize:Theme.muted;}
    TouchArea {enabled:root.enabled && root.model.length>0;mouse-cursor:pointer;clicked=>{key.focus();root.open();}}
    key:=FocusScope {width:0px;height:0px;enabled:root.enabled && root.model.length>0;
        key-pressed(e)=>{if e.text==Key.Return || e.text==" " {root.open();return accept;}if e.text==Key.DownArrow {root.choose(min(root.model.length - 1,root.current-index+1));return accept;}if e.text==Key.UpArrow {root.choose(max(0,root.current-index - 1));return accept;}if e.text==Key.Home {root.choose(0);return accept;}if e.text==Key.End {root.choose(root.model.length - 1);return accept;}return reject;}
    }
    forward-focus:key;
    accessible-role:combobox;accessible-label:root.label;accessible-value:root.current-value;accessible-enabled:root.enabled && root.model.length>0;accessible-expanded:root.expanded;
    accessible-action-default=>{root.open();}
    popup:=PopupWindow {x:0px;y:root.height+4px;width:root.width;height:min(root.model.length,8)*Theme.control-regular+8px;close-policy:close-on-click-outside;forward-focus:popup-focus;
        popup-focus:=FocusScope {
            focus-changed-event=>{root.expanded=self.has-focus;}
            key-pressed(e)=>{if e.text==Key.Escape {popup.close();key.focus();return accept;}if e.text==Key.Return || e.text==" " {root.choose(root.highlighted);return accept;}if e.text==Key.DownArrow {root.move-highlight(1);return accept;}if e.text==Key.UpArrow {root.move-highlight(-1);return accept;}if e.text==Key.Home {root.highlighted=0;return accept;}if e.text==Key.End {root.highlighted=root.model.length - 1;return accept;}if e.text==Key.Tab {popup.close();key.focus();return reject;}return reject;}
            Panel {variant:SurfaceVariant.popup;
                ScrollArea {x:4px;y:4px;width:parent.width - 8px;height:parent.height - 8px;viewport-width:self.visible-width;viewport-y:-max(0,root.highlighted - 7)*Theme.control-regular;
                    VerticalLayout {spacing:0px;alignment:start;
                        for value[index] in root.model: Rectangle {height:Theme.control-regular;border-radius:Theme.radius-small;background:row-touch.has-hover || root.highlighted==index ? Theme.selection : transparent;
                            Text {x:8px;width:parent.width - 30px;height:parent.height;text:value;color:Theme.text;font-size:Theme.font-control;vertical-alignment:center;overflow:elide;}
                            if root.current-index==index: Image {x:parent.width - 20px;y:8px;width:14px;height:14px;source:@image-url("../../assets/icons/Check-regular.svg");colorize:Theme.accent-text;}
                            row-touch:=TouchArea {mouse-cursor:pointer;clicked=>{root.choose(index);}}
                            accessible-role:button;accessible-label:value;accessible-action-default=>{root.choose(index);}
                        }
                    }
                }
            }
        }
    }
}
