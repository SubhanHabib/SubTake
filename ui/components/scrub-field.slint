import { Theme } from "../theme.slint";
import { FineSlider } from "slider.slint";
import { ValueInput } from "input.slint";
// Filled slider with an editable number. Drag commits on release; typing on Enter.
export component ScrubField inherits Rectangle {
    in property <string> label;
    in property <image> icon:@image-url("../../assets/icons/SlidersHorizontal-regular.svg");
    in property <float> value;
    in property <float> minimum:0;
    in property <float> maximum:1;
    in property <bool> enabled:true;
    callback committed(string);
    height:Theme.control-height;
    FineSlider {width:parent.width;filled:true;enabled:root.enabled;label:root.label;label-icon:root.icon;minimum:root.minimum;maximum:root.maximum;value:root.value;released(value)=>{root.committed(value);}}
    ValueInput {x:parent.width - 76px;y:0px;width:70px;height:Theme.control-height;border-radius:Theme.radius-control;background:self.has-focus ? Theme.input : Theme.dark ? #ffffff12 : #e7e7e5;border-width:self.has-focus ? Theme.focus-width : 0px;enabled:root.enabled;text:round(root.value*100)/100;label:root.label;accepted=>{root.committed(self.text);}}
}
