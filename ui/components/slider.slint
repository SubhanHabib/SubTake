import { ProgressTrack } from "progress.slint";
import { Theme } from "../theme.slint";
export component FineSlider inherits Rectangle {
    in property <bool> enabled:true;
    in property <bool> filled:false;
    in property <bool> endpoint-icons:false;
    in property <image> minimum-icon;
    in property <image> maximum-icon;
    in property <bool> progress-style:false;
    in property <float> minimum:0;
    in property <float> maximum:1;
    in property <float> value;
    in property <string> label;
    in property <image> label-icon:@image-url("../../assets/icons/SlidersHorizontal-regular.svg");
    callback released(float);
    callback changed(float);
    private property <bool> dragging:false;
    private property <float> draft;
    height:Theme.control-height;min-width:64px;
    border-radius:Theme.radius-control;background:root.progress-style ? transparent : Theme.surface;opacity:root.enabled ? 1 : Theme.disabled-opacity;
    private property <length> track-inset:root.filled ? 0px : root.progress-style ? Theme.control-padding : Theme.control-padding + 8px;
    private property <float> fraction:clamp(((root.dragging ? root.draft : root.value) - root.minimum)/max(0.0001,root.maximum - root.minimum),0,1);
    if root.filled: Rectangle {x:0px;width:max(12px,parent.width*root.fraction);height:parent.height;border-radius:Theme.radius-control;background:Theme.dark ? #ffffff30 : #ffffff;}
    if root.filled && !root.endpoint-icons: Image {x:Theme.control-padding;y:(parent.height - Theme.icon-size)/2;width:Theme.icon-size;height:Theme.icon-size;source:root.label-icon;colorize:Theme.text;}
    if root.filled && !root.endpoint-icons: Text {x:Theme.control-padding + Theme.icon-size + Theme.gap;width:max(0px,parent.width - self.x - 82px);height:parent.height;text:root.label;color:Theme.text;font-size:Theme.font-control;vertical-alignment:center;overflow:elide;}
    if root.filled: Rectangle {x:clamp(parent.width*root.fraction - 8px,6px,parent.width - 8px);y:12px;width:2px;height:parent.height - 24px;border-radius:1px;background:Theme.muted.with-alpha(0.6);}
    if !root.filled && !root.progress-style: Rectangle {x:root.track-inset;width:parent.width - 2*root.track-inset;y:(parent.height - 4px)/2;height:4px;border-radius:2px;background:Theme.border;
        Rectangle {x:0px;width:parent.width*root.fraction;height:parent.height;border-radius:2px;background:Theme.muted;}
    }
    if !root.filled && !root.progress-style: Rectangle {x:root.track-inset + root.fraction*(parent.width - 2*root.track-inset) - 8px;y:(parent.height - 16px)/2;width:16px;height:16px;border-radius:8px;background:Theme.text;border-width:focus.has-focus ? 2px : 0px;border-color:Theme.blue;}
    if root.progress-style: ProgressTrack {x:root.track-inset;y:(parent.height - self.height)/2;width:parent.width - 2*root.track-inset;progress:root.fraction;}
    if root.endpoint-icons: Image {x:Theme.control-padding;y:(parent.height - Theme.icon-size)/2;width:Theme.icon-size;height:Theme.icon-size;source:root.minimum-icon;colorize:Theme.text;image-fit:contain;}
    if root.endpoint-icons: Image {x:parent.width - Theme.control-padding - Theme.icon-size;y:(parent.height - Theme.icon-size)/2;width:Theme.icon-size;height:Theme.icon-size;source:root.maximum-icon;colorize:Theme.text;image-fit:contain;}
    TouchArea {enabled:root.enabled;mouse-cursor:pointer;
        pointer-event(e)=>{if e.kind==PointerEventKind.down {focus.focus();root.draft=root.minimum+clamp((self.mouse-x - root.track-inset)/max(1px,self.width - 2*root.track-inset),0,1)*(root.maximum - root.minimum);root.dragging=true;root.changed(root.draft);}if e.kind==PointerEventKind.up && root.dragging {root.dragging=false;root.released(root.draft);}}
        moved=>{if self.pressed {root.draft=root.minimum+clamp((self.mouse-x - root.track-inset)/max(1px,self.width - 2*root.track-inset),0,1)*(root.maximum - root.minimum);root.changed(root.draft);}}
    }
    focus:=FocusScope {enabled:root.enabled;width:0px;height:0px;key-pressed(e)=>{if e.text==Key.LeftArrow || e.text==Key.RightArrow {root.released(clamp(root.value+(e.text==Key.LeftArrow ? -1 : 1)*(root.maximum - root.minimum)/100,root.minimum,root.maximum));return accept;}return reject;}}
    border-width:(root.filled || root.progress-style) && focus.has-focus ? Theme.focus-width : 0px;border-color:Theme.blue;
    forward-focus:focus;
    accessible-enabled:root.enabled;accessible-role:slider;accessible-label:root.label;accessible-value:root.value;accessible-value-minimum:root.minimum;accessible-value-maximum:root.maximum;
