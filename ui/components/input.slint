import { Theme, ControlSize } from "../theme.slint";
export component ValueInput inherits Rectangle {
    in-out property <string> text;
    in property <string> label;
    in property <string> placeholder;
    in property <bool> enabled:true;
    in property <bool> read-only:false;
    in property <bool> invalid:false;
    in property <ControlSize> size:compact;
    out property <bool> has-focus:input.has-focus;
    callback accepted;
    callback edited(string);
    height:Theme.control-height;
    min-width:46px;vertical-stretch:0;opacity:root.enabled ? 1 : Theme.disabled-opacity;
    background:Theme.input;border-radius:Theme.radius-small;border-width:root.has-focus ? Theme.focus-width : Theme.border-width;border-color:root.invalid ? Theme.danger : root.has-focus ? Theme.blue : Theme.border;
    if root.text=="": Text {x:Theme.input-padding;width:parent.width - 2*Theme.input-padding;height:parent.height;text:root.placeholder;color:Theme.muted;font-size:Theme.font-control;vertical-alignment:center;overflow:elide;}
    input:=TextInput {x:Theme.input-padding;y:0px;width:parent.width - 2*Theme.input-padding;height:parent.height;text <=> root.text;color:Theme.text;font-size:Theme.font-control;single-line:true;vertical-alignment:center;enabled:root.enabled;read-only:root.read-only;accepted=>{root.accepted();}edited=>{root.edited(self.text);}accessible-label:root.label;}
    forward-focus:input;
}
