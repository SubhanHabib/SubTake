// View-only magnification. Children use image coordinates, including edit overlays.
export component PreviewViewport inherits Rectangle {
    in property <bool> enabled:true;
    in property <float> aspect:1.777778;
    in-out property <float> zoom:1;
    in-out property <length> pan-x:0px;
    in-out property <length> pan-y:0px;
    out property <length> image-width:min(self.width - 8px,(self.height - 8px)*root.aspect)*root.zoom;
    out property <length> image-height:root.image-width/root.aspect;
    out property <length> image-x:(self.width - root.image-width)/2+clamp(root.pan-x,-max(0px,(root.image-width - self.width)/2),max(0px,(root.image-width - self.width)/2));
    out property <length> image-y:(self.height - root.image-height)/2+clamp(root.pan-y,-max(0px,(root.image-height - self.height)/2),max(0px,(root.image-height - self.height)/2));
    clip:true;
    public function reset() {root.zoom=1;root.pan-x=0px;root.pan-y=0px;}
    changed aspect=>{root.reset();}
    changed enabled=>{if !root.enabled {root.reset();}}
    ScaleRotateGestureHandler {
        enabled:root.enabled;
        private property <float> initial-zoom;
        private property <float> anchor-x;
        private property <float> anchor-y;
        started=>{
            self.initial-zoom=root.zoom;
            self.anchor-x=(self.center.x - root.image-x)/root.image-width;
            self.anchor-y=(self.center.y - root.image-y)/root.image-height;
        }
        updated=>{
            root.zoom=clamp(self.initial-zoom*self.scale,1,8);
            root.pan-x=clamp(self.center.x - self.anchor-x*root.image-width - (root.width - root.image-width)/2,-max(0px,(root.image-width - root.width)/2),max(0px,(root.image-width - root.width)/2));
            root.pan-y=clamp(self.center.y - self.anchor-y*root.image-height - (root.height - root.image-height)/2,-max(0px,(root.image-height - root.height)/2),max(0px,(root.image-height - root.height)/2));
        }
        TouchArea {
            scroll-event(e)=>{
                if root.enabled && root.zoom>1 {
                    root.pan-x=clamp(root.pan-x+e.delta-x,-max(0px,(root.image-width - root.width)/2),max(0px,(root.image-width - root.width)/2));
                    root.pan-y=clamp(root.pan-y+e.delta-y,-max(0px,(root.image-height - root.height)/2),max(0px,(root.image-height - root.height)/2));
                    return accept;
                }
                return reject;
            }
            Rectangle {x:root.image-x;y:root.image-y;width:root.image-width;height:root.image-height;
                @children
            }
        }
    }
}
