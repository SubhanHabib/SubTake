import { Palette } from "std-widgets.slint";
export global Theme {
    out property <bool> dark: Palette.background.red < 128;
    out property <color> bg: dark ? #11111388 : #fafaf966;
    out property <color> header: dark ? #15151766 : #ffffff55;
    out property <color> panel: dark ? #16161855 : #ffffff48;
    out property <color> surface: dark ? #20202466 : #e7e7e766;
    out property <color> border: dark ? #ffffff18 : #22222210;
    out property <color> text: dark ? #f5f5f6 : #292a2d;
    out property <color> muted: dark ? #a3a3ad : #77797e;
    out property <color> blue: #5b8cff;
    out property <color> selection: dark ? #5b8cff24 : #eaf0ff;
    out property <color> input: dark ? #0e0e10 : #f1f1f0;
    out property <color> hover: dark ? #ffffff0e : #1822350c;

    out property <color> accent-hover: #7699ff;
    out property <color> accent-text: dark ? #dce5ff : #304a9a;
    out property <color> danger: dark ? #f43f5e : #d51e43;
    out property <color> toggle-thumb: #ffffff;
    out property <color> on-accent: #ffffff;
    out property <color> unchecked: dark ? #ffffff22 : #18223530;
    // Floating surfaces are soft and translucent, matching the rounded reference UI.
    out property <color> overlay: dark ? #202126a6 : #ffffffa6;
    out property <color> popup: dark ? #202126f5 : #fafafaf5;
    out property <color> overlay-shadow: dark ? #00000055 : #00000018;
    out property <color> canvas-dot: dark ? #ffffff10 : #292a2d13;
    out property <color> track: dark ? #ffffff09 : #ececeb66;
    out property <color> playhead: dark ? #d6d6d5 : #737570;
    out property <color> warning: #e8b251;
    out property <float> disabled-opacity: 0.4;
    out property <length> font-small: 10px;
    out property <length> font-control: 12px;
    out property <length> font-body: 12px;
    out property <length> font-heading: 14px;
    out property <string> font-family: "Helvetica Neue";
    out property <length> radius-small: 8px;
    out property <length> radius-control: 16px;
    out property <length> radius-card: 16px;
    out property <length> radius-panel: 20px;
    out property <length> radius-overlay: 24px;
    out property <length> border-width: 1px;
    out property <length> focus-width: 2px;
    out property <length> slider-focus-width: 1px;
    out property <color> slider-focus-color: #00000080;
    out property <length> control-height: 40px;
    out property <length> slider-fill-inset: 1px;
    out property <length> slider-fill-radius: radius-control - slider-fill-inset;
    // Compatibility size names all use the same comfortable control height.
    out property <length> control-small: control-height;
    out property <length> control-compact: control-height;
    out property <length> control-regular: control-height;
    out property <length> control-large: control-height;
    out property <length> icon-size: 16px;
    out property <length> gap-small: 4px;
    out property <length> gap: 8px;
    out property <length> gap-large: 12px;
    out property <length> control-padding: (control-height - icon-size)/2;
    out property <length> input-padding: control-padding;
}
export enum ControlSize { small, compact, regular, large }
