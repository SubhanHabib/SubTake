import { AppMark } from "components/app-mark.slint";
export { PrimitiveGallery } from "primitives-gallery.slint";
import { Palette } from "std-widgets.slint";
export struct Region { id: string, kind: string, label: string, start: float, end: float, row: int, tint: color, selected: bool }
export struct Field { key: string, label: string, value: string, kind: int, minimum: float, maximum: float, choices: [string], values: [string], choice: int }
export struct Wallpaper { key: string, title: string, source: image }
import { PreviewViewport, TimelineScrubber, ScrubField, Theme, ToolButton, IconButton, RailButton, Toggle, FineSlider, ValueInput, Dropdown, RecordButton, Panel, Divider, ChoiceTile, ScrollArea, ProgressBar, Label, FieldRow, SegmentedControl } from "controls.slint";
import { SettingCard, MotionChoices, CursorChoices, PositionChoices } from "choices.slint";
export component EditorWindow inherits Window {
    title:root.document-title + (root.dirty ? root.translate(" •",root.language) : root.translate("",root.language)) + root.translate(" — SubTake",root.language);
    preferred-width: 1360px; preferred-height: 880px; min-width: 980px; min-height: 680px;
    background: Theme.bg;
    default-font-family: Theme.font-family;
    default-font-size: 12px;
    in property <string> appearance:"system";
    in property <bool> auto-apply-zooms:true;
    in property <bool> connect-zooms:true;
    in property <string> motion-choice;
    in property <string> look-choice;


    init => { Palette.color-scheme = root.appearance=="light" ? ColorScheme.light : root.appearance=="dark" ? ColorScheme.dark : ColorScheme.unknown; }
    changed appearance => { Palette.color-scheme = root.appearance=="light" ? ColorScheme.light : root.appearance=="dark" ? ColorScheme.dark : ColorScheme.unknown; }
    in property <string> language: "";
    pure callback translate(string,string)->string;
    in property <string> document-title:root.translate("Untitled",root.language);
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <[Wallpaper]> wallpapers;
    in-out property <int> aspect-index: 0;
    in property <string> background-value;
    in property <bool> dirty: false;
    in property <bool> has-video: false;
    in property <bool> playing: false;
    in property <bool> recording: false;
    in property <bool> recording-paused: false;
    in property <bool> busy: false;
    in property <bool> sources-loading: false;
    in property <bool> mac-titlebar: false;
    in property <string> recording-hint: "Choose a display or window, then start recording.";
    in property <string> status: "Open a video or start a recording";
    in property <float> progress: 0;
    in property <image> preview;
    in property <bool> edit-visible: false;
    in property <float> edit-x;
    in property <float> edit-y;
    in property <float> edit-width;
    in property <float> edit-height;
    in property <float> edit-scale: 1;
    callback canvas-edit(float,float,bool);
    in property <image> thumbnails;
    in property <image> frosted-thumbnails;
    in property <image> waveform;
    in-out property <float> preview-zoom:1;
    out property <float> preview-pixel-width:preview-viewport.image-width / 1px;
    public function reset-preview() {preview-viewport.reset();}
    in property <float> preview-aspect: 1.777778;
    in property <float> duration: 1;
    in property <float> playhead: 0;
    in-out property <float> timeline-zoom: 1;
    in-out property <float> timeline-offset: 0;
    in-out property <bool> snap: true;
    out property <float> timeline-visible: max(0.001,root.duration/root.timeline-zoom);
    in property <string> time-label: "00:00.000";
    in property <[Region]> regions;
    in property <int> audio-row: 3;
    in property <[string]> track-labels: ["Zoom","Clip","Annotation","Audio","Caption"];
    in property <string> selected-id;
    in property <[Field]> fields;
    in property <[string]> source-names;
    in-out property <int> source-index: 0;
    in property <[string]> camera-names: ["System default"];
    in property <[string]> microphone-names: ["System default"];
    in-out property <int> camera-index: 0;
    in-out property <int> microphone-index: 0;
    in-out property <bool> capture-mic: true;
    in-out property <bool> capture-camera: false;
    in-out property <bool> capture-system: true;
    in-out property <string> panel: "Frame";
    in-out property <int> panel-index: 0;
    changed panel => {inspector-scroll.viewport-y=0px;root.panel-index=root.panel=="Frame"?0:root.panel=="Cursor"?1:root.panel=="Webcam"?2:root.panel=="Captions"?3:root.panel=="Selection"?4:root.panel=="Recording"?5:root.panel=="Export"?6:root.panel=="Audio"?7:root.panel=="Preferences"?8:root.panel=="Recent"?9:root.panel=="Wallpapers"?10:root.panel=="Crop"?11:root.panel=="Presets"?12:13;}
    callback action(string);
    callback seek(float);
    callback select-region(string,string,bool);
    callback move-region(string,string,float,int);
    callback field-change(string,string);
    callback panel-change(string);
    callback preview-click(float,float);
    callback keyboard(string,bool,bool,bool)->bool;
    MenuBar {
        Menu { title:root.translate("File",root.language);
            MenuItem { title:root.translate("Open…",root.language); activated => { root.action("open"); } }
            MenuItem { title:root.translate("Save",root.language); activated => {root.action("save");} }
            MenuItem { title:root.translate("Save As…",root.language); activated => {root.action("save-as");} }
            MenuItem { title:root.translate("Export…",root.language); activated => {root.panel="Export";root.panel-change("Export");} }
        }
        Menu {title:root.translate("Help",root.language); MenuItem {title:root.translate("Keyboard shortcuts",root.language);activated=>{root.action("shortcut-reference");}} MenuItem {title:root.translate("Feedback and issues",root.language);activated=>{root.action("feedback");}}}
        Menu {title:root.translate("Edit",root.language);
            MenuItem {title:root.translate("Undo",root.language);activated=>{root.action("undo");}}
            MenuItem {title:root.translate("Redo",root.language);activated=>{root.action("redo");}}
            MenuItem {title:root.translate("Add marker",root.language);activated=>{root.action("add-marker");}}
            MenuItem {title:root.translate("Previous marker",root.language);activated=>{root.action("previous-marker");}}
            MenuItem {title:root.translate("Next marker",root.language);activated=>{root.action("next-marker");}}
            MenuItem {title:root.translate("Split clip at playhead",root.language);activated=>{root.action("split-clip");}}
            MenuItem {title:root.translate("Select all regions",root.language);activated=>{root.action("select-all");}}
            MenuItem {title:root.translate("Next overlapping annotation",root.language);activated=>{root.action("next-annotation");}}
            MenuItem {title:root.translate("Previous overlapping annotation",root.language);activated=>{root.action("previous-annotation");}}
            MenuItem {title:root.translate("Copy region",root.language);activated=>{root.action("copy");}}
            MenuItem {title:root.translate("Cut region",root.language);activated=>{root.action("cut");}}
            MenuItem {title:root.translate("Paste region",root.language);activated=>{root.action("paste");}}
            MenuItem {title:root.translate("Duplicate region",root.language);activated=>{root.action("duplicate");}}
            MenuItem {title:root.translate("Delete region",root.language);activated=>{root.action("delete");}}
        }
    }
    function show-panel(name: string) {root.panel=name;root.panel-change(name);}
    pure function panel-title(name:string)->string {return name=="Frame" ? "Scene" : name=="Preferences" ? "Settings" : name=="Recent" ? "Projects" : name=="Wallpapers" ? "Background" : name;}
    focus := FocusScope {
        key-pressed(event) => { if root.keyboard(event.text,event.modifiers.control || event.modifiers.meta,event.modifiers.shift,event.modifiers.alt) {return accept;} return reject; }
        VerticalLayout {spacing:0;
            Rectangle {height:56px;background:Theme.header;
                Rectangle {y:parent.height - 1px;height:1px;background:Theme.border;}
                HorizontalLayout {padding-left:root.mac-titlebar ? 88px : 16px;padding-right:16px;padding-top:6px;padding-bottom:6px;spacing:6px;
                    AppMark {}
                    IconButton {icon:@image-url("../assets/icons/FolderOpen-regular.svg");label:root.translate("Open projects",root.language);variant:ghost;clicked=>{root.show-panel("Recent");}}
                    IconButton {icon:@image-url("../assets/icons/FloppyDisk-regular.svg");label:root.translate("Save",root.language);variant:ghost;enabled:root.has-video;clicked=>{root.action("save");}}
                    Rectangle {width:1px;Rectangle {y:(parent.height - 18px)/2;width:1px;height:18px;background:Theme.border;}}
                    IconButton {icon:@image-url("../assets/icons/ArrowCounterClockwise-regular.svg");label:root.translate("Undo",root.language);enabled:root.can-undo;clicked=>{root.action("undo");}}
                    IconButton {icon:@image-url("../assets/icons/ArrowClockwise-regular.svg");label:root.translate("Redo",root.language);enabled:root.can-redo;clicked=>{root.action("redo");}}
                    Rectangle {horizontal-stretch:1;TouchArea {pointer-event(e)=>{if e.kind==PointerEventKind.down {root.action("drag-window");}}}}
                    ToolButton {icon:@image-url("../assets/icons/Record-regular.svg");text:root.recording ? root.translate("Stop",root.language) : root.translate("Record",root.language);variant:ghost;icon-color:root.recording ? #fb656d : Theme.muted;enabled:!root.busy;clicked=>{root.action(root.recording ? "stop-recording" : "record");}}
                    if root.recording: IconButton {icon:root.recording-paused ? @image-url("../assets/icons/Play-fill.svg") : @image-url("../assets/icons/Pause-fill.svg");label:root.recording-paused ? "Resume" : "Pause";clicked=>{root.action("pause-recording");}}
                    ToolButton {icon:@image-url("../assets/icons/Stack-regular.svg");text:root.translate("Presets",root.language);variant:ghost;clicked=>{root.show-panel("Presets");}}
                    ToolButton {icon:@image-url("../assets/icons/Export-regular.svg");text:root.translate("Export",root.language);variant:primary;enabled:root.has-video&&!root.busy;clicked=>{root.show-panel("Export");}}
                }
                Rectangle {x:(parent.width - self.width)/2;width:min(230px,parent.width*0.22);height:parent.height;background:transparent;
                    TouchArea {pointer-event(e)=>{if e.kind==PointerEventKind.down {root.action("drag-window");}}}
                    HorizontalLayout {alignment:center;spacing:6px;
                        if root.dirty: Rectangle {width:5px;Rectangle {y:(parent.height - 5px)/2;width:5px;height:5px;border-radius:3px;background:Theme.blue;}}
                        Label {text:root.document-title;color:Theme.text;font-size:Theme.font-body;font-weight:600;overflow:elide;vertical-alignment:center;}
                    }
                }
            }
            HorizontalLayout {padding:12px;spacing:12px;vertical-stretch:1;min-height:340px;
                rail-scroll := ScrollArea {width:52px;viewport-width:52px;viewport-height:max(self.visible-height,386px);
                VerticalLayout {width:52px;height:max(rail-scroll.visible-height,386px);spacing:2px;
                    RailButton {text:root.translate("Scene",root.language);icon:self.active ? @image-url("../assets/icons/Sparkle-fill.svg") : @image-url("../assets/icons/Sparkle-regular.svg");active:root.panel=="Frame" || root.panel=="Wallpapers" || root.panel=="Crop" || root.panel=="Presets";clicked=>{root.show-panel("Frame");}}
                    RailButton {text:root.translate("Cursor",root.language);icon:self.active ? @image-url("../assets/icons/Cursor-fill.svg") : @image-url("../assets/icons/Cursor-regular.svg");active:root.panel=="Cursor";clicked=>{root.show-panel("Cursor");}}
                    RailButton {text:root.translate("Webcam",root.language);icon:self.active ? @image-url("../assets/icons/Camera-fill.svg") : @image-url("../assets/icons/Camera-regular.svg");active:root.panel=="Webcam";clicked=>{root.show-panel("Webcam");}}
                    RailButton {text:root.translate("Captions",root.language);icon:self.active ? @image-url("../assets/icons/ClosedCaptioning-fill.svg") : @image-url("../assets/icons/ClosedCaptioning-regular.svg");active:root.panel=="Captions";clicked=>{root.show-panel("Captions");}}
                    RailButton {text:root.translate("Audio",root.language);icon:self.active ? @image-url("../assets/icons/SpeakerHigh-fill.svg") : @image-url("../assets/icons/SpeakerHigh-regular.svg");active:root.panel=="Audio";clicked=>{root.show-panel("Audio");}}
                    Rectangle {vertical-stretch:1;}
                    RailButton {text:root.translate("Settings",root.language);icon:self.active ? @image-url("../assets/icons/Gear-fill.svg") : @image-url("../assets/icons/Gear-regular.svg");active:root.panel=="Preferences" || root.panel=="Shortcuts";clicked=>{root.show-panel("Preferences");}}
                    HorizontalLayout {height:Theme.control-height;alignment:center;IconButton {icon:@image-url("../assets/icons/Question-regular.svg");label:root.translate("Keyboard shortcuts",root.language);variant:ghost;clicked=>{root.action("shortcut-reference");}}}
                }
                }
                VerticalLayout {spacing:6px;horizontal-stretch:1;
                    if root.has-video: HorizontalLayout {height:Theme.control-height;alignment:center;spacing:8px;
                        Dropdown {label:"Aspect ratio";width:96px;size:compact;model:["Native","16:9","9:16","1:1","4:3","3:2"];current-index <=> root.aspect-index;selected(value)=>{root.field-change("aspectRatio",["native","16:9","9:16","1:1","4:3","3:2"][self.current-index]);}}
                        Rectangle {width:1px;height:14px;background:Theme.border;}
                        ToolButton {icon:@image-url("../assets/icons/Crop-regular.svg");text:root.translate("Crop",root.language);variant:ghost;active:root.panel=="Crop";enabled:root.has-video;clicked=>{root.action("visual-crop");}}
                        ToolButton {has-icon:false;text:root.preview-zoom>1.001 ? "Fit · "+round(root.preview-zoom*100)+"%" : "Fit";label:"Reset preview to fit";variant:ghost;clicked=>{root.reset-preview();}}
                    }
                    Rectangle {vertical-stretch:1;background:transparent;clip:true;
                        for row in ceil(self.height/20px): Rectangle {y:row*20px;height:2px;
                            for column in ceil(self.width/20px): Rectangle {x:column*20px;width:1.5px;height:1.5px;border-radius:1px;background:Theme.canvas-dot;}
                        }
                        preview-viewport := PreviewViewport {enabled:root.has-video;aspect:root.preview-aspect;zoom <=> root.preview-zoom;
                        image-area := Rectangle {x:0px;y:0px;clip:true;width:preview-viewport.image-width;height:preview-viewport.image-height;background:transparent;border-radius:20px;
                            Image {visible:root.has-video;source:root.preview;image-fit:contain;width:parent.width;height:parent.height;}
                            TouchArea {clicked=>{root.preview-click(self.mouse-x/self.width,self.mouse-y/self.height);}}
                            if root.edit-visible && !root.playing: Rectangle {x:root.edit-x*parent.width;y:root.edit-y*parent.height;width:root.edit-width*parent.width;height:root.edit-height*parent.height;background:transparent;border-color:#6294ff;border-width:1.5px;
                                TouchArea {private property <length> origin-x;private property <length> origin-y;pointer-event(e)=>{if e.kind==PointerEventKind.down {self.origin-x=self.mouse-x;self.origin-y=self.mouse-y;}if e.kind==PointerEventKind.up {root.canvas-edit((self.mouse-x - self.origin-x)/image-area.width,(self.mouse-y - self.origin-y)/image-area.height,false);}}}
                                Rectangle {x:parent.width - 5px;y:parent.height - 5px;width:10px;height:10px;border-radius:2px;background:#fff;border-width:1px;border-color:Theme.blue;
                                    TouchArea {private property <length> origin-x;private property <length> origin-y;pointer-event(e)=>{if e.kind==PointerEventKind.down {self.origin-x=self.mouse-x;self.origin-y=self.mouse-y;}if e.kind==PointerEventKind.up {root.canvas-edit((self.mouse-x - self.origin-x)/image-area.width,(self.mouse-y - self.origin-y)/image-area.height,true);}}}
                                }
                            }
                        }
                        }
                        if !root.has-video: VerticalLayout {alignment:center;spacing:14px;
                            HorizontalLayout {alignment:center;height:42px;Image {height:42px;width:42px;source:@image-url("../assets/icons/FilmStrip-regular.svg");colorize:#72727c;}}
                            Label {text:root.translate("No Video Loaded",root.language);color:Theme.text;font-size:22px;font-weight:600;horizontal-alignment:center;}
                            Label {text:root.translate("Open a video or start a recording",root.language);color:Theme.muted;font-size:Theme.font-body;horizontal-alignment:center;}
                            HorizontalLayout {alignment:center;spacing:8px;ToolButton {icon:@image-url("../assets/icons/FolderOpen-regular.svg");text:root.translate("Open video",root.language);enabled:!root.busy;clicked=>{root.action("open");}}ToolButton {icon:@image-url("../assets/icons/Record-regular.svg");text:"New recording";variant:primary;enabled:!root.busy && !root.recording;clicked=>{root.action("record");}}}
                        }
                    }
                    if root.has-video: Rectangle {height:40px;
                        Label {x:6px;height:parent.height;width:180px;text:root.time-label;color:Theme.muted;font-size:Theme.font-small;vertical-alignment:center;}
                        HorizontalLayout {alignment:center;spacing:8px;
                            IconButton {icon:@image-url("../assets/icons/SkipBack-fill.svg");label:root.translate("Previous frame",root.language);variant:ghost;enabled:root.has-video;clicked=>{root.action("previous-frame");}}
                            IconButton {size:regular;icon:root.playing ? @image-url("../assets/icons/Pause-fill.svg") : @image-url("../assets/icons/Play-fill.svg");label:root.playing ? root.translate("Pause",root.language) : root.translate("Play",root.language);round:true;enabled:root.has-video;clicked=>{root.action("play");}}
                            IconButton {icon:@image-url("../assets/icons/SkipForward-fill.svg");label:root.translate("Next frame",root.language);variant:ghost;enabled:root.has-video;clicked=>{root.action("next-frame");}}
                        }
                        IconButton {x:parent.width - Theme.control-height;icon:@image-url("../assets/icons/SpeakerHigh-regular.svg");label:root.translate("Audio",root.language);variant:ghost;clicked=>{root.show-panel("Audio");}}
                    }
                }
                Panel {width:280px;background:Theme.panel;
                    VerticalLayout {padding:14px;spacing:12px;
                        HorizontalLayout {height:Theme.control-height;spacing:6px;
                            if root.panel=="Shortcuts": IconButton {size:small;icon:@image-url("../assets/icons/CaretLeft-regular.svg");label:"Settings";variant:ghost;clicked=>{root.show-panel("Preferences");}}
                            if root.panel=="Crop" || root.panel=="Wallpapers" || root.panel=="Presets": IconButton {size:small;icon:@image-url("../assets/icons/CaretLeft-regular.svg");label:root.translate("Scene",root.language);variant:ghost;clicked=>{root.show-panel("Frame");}}
                            Label {text:root.translate(root.panel-title(root.panel),root.language);color:Theme.text;font-size:Theme.font-heading;font-weight:600;vertical-alignment:center;horizontal-stretch:1;}
                            if root.panel=="Frame": IconButton {size:small;icon:@image-url("../assets/icons/Image-regular.svg");label:root.translate("Background",root.language);variant:ghost;clicked=>{root.action("wallpapers");}}
                        }
                        if root.panel=="Frame" || root.panel=="Wallpapers": HorizontalLayout {height:Theme.control-height;spacing:6px;
                            ToolButton {size:compact;has-icon:false;text:root.translate("Scene",root.language);active:root.panel=="Frame";horizontal-stretch:1;clicked=>{root.show-panel("Frame");}}
                            ToolButton {size:compact;has-icon:false;text:root.translate("Background",root.language);active:root.panel=="Wallpapers";horizontal-stretch:1;clicked=>{root.action("wallpapers");}}
                        }
                        inspector-scroll := ScrollArea {vertical-stretch:1;viewport-width:self.visible-width;
                            VerticalLayout {spacing:10px;padding-right:16px;alignment:start;
                                if root.panel=="Recording": VerticalLayout {spacing:10px;vertical-stretch:0;
                                    Label {text:root.translate("Capture source",root.language);color:Theme.muted;font-size:Theme.font-control;}
                                    Dropdown {label:"Capture source";enabled:!root.busy && root.source-names.length>0;model:root.source-names;current-index <=> root.source-index;}
                                    ToolButton {has-icon:false;text:root.sources-loading ? "Finding sources…" : root.translate("Refresh displays and windows",root.language);enabled:!root.busy;clicked=>{root.action("sources");}}
                                    HorizontalLayout {height:Theme.control-height;Label {text:root.translate("Camera",root.language);color:Theme.text;vertical-alignment:center;}Toggle {label:"Camera";checked:root.capture-camera;toggled(value)=>{root.capture-camera=value;}}}
                                    if root.capture-camera: Dropdown {label:"Camera";model:root.camera-names;current-index <=> root.camera-index;}
                                    HorizontalLayout {height:Theme.control-height;Label {text:root.translate("Microphone",root.language);color:Theme.text;vertical-alignment:center;}Toggle {label:"Microphone";checked:root.capture-mic;toggled(value)=>{root.capture-mic=value;}}}
                                    if root.capture-mic: Dropdown {label:"Microphone";model:root.microphone-names;current-index <=> root.microphone-index;}
                                    HorizontalLayout {height:Theme.control-height;Label {text:root.translate("System audio",root.language);color:Theme.text;vertical-alignment:center;}Toggle {label:"System audio";checked:root.capture-system;toggled(value)=>{root.capture-system=value;}}}
                                }
                                if root.panel=="Recent": ToolButton {icon:@image-url("../assets/icons/Sparkle-regular.svg");text:"Create video · spike";variant:primary;clicked=>{root.action("storyboard-spike");}}
                                if root.panel=="Recent": ToolButton {icon:@image-url("../assets/icons/Plus-regular.svg");text:root.translate("Import video or project",root.language);clicked=>{root.action("open");}}
                                if root.panel=="Selection" && root.selected-id=="": Label {text:root.translate("Select a clip or effect in the timeline to edit it.",root.language);wrap:word-wrap;color:Theme.muted;font-size:Theme.font-body;}
                                if root.panel=="Wallpapers": VerticalLayout {spacing:10px;
                                    Label {text:root.translate("Choose a background",root.language);color:Theme.muted;font-size:Theme.font-control;}
                                    Rectangle {height:ceil(root.wallpapers.length/3)*62px;
                                        for tile[i] in root.wallpapers: ChoiceTile {x:mod(i,3)*(parent.width+6px)/3;y:floor(i/3)*62px;width:(parent.width - 12px)/3;height:54px;clip:true;label:tile.title;clicked=>{root.action(tile.key);}
                                            Image {source:tile.source;image-fit:cover;width:parent.width;height:parent.height;}
                                        }
                                    }
                                    ToolButton {icon:@image-url("../assets/icons/Plus-regular.svg");text:root.translate("Upload image or video",root.language);clicked=>{root.action("choose-background");}}
                                    Label {text:root.translate("Color",root.language);color:Theme.muted;font-size:Theme.font-control;}
                                    HorizontalLayout {spacing:6px;
                                        for swatch in [{color:#17171c,value:"#17171c"},{color:#22364a,value:"#22364a"},{color:#253c32,value:"#253c32"},{color:#54324a,value:"#54324a"},{color:#784832,value:"#784832"},{color:#ededed,value:"#ededed"}]: ChoiceTile {height:27px;background:swatch.color;label:"Background "+swatch.value;active:root.background-value==swatch.value;clicked=>{root.field-change("wallpaper",swatch.value);}
                                        }
                                    }
                                    ValueInput {text:root.background-value;label:root.translate("Background color or gradient",root.language);accepted=>{root.field-change("wallpaper",self.text);}}
                                }
                                if root.panel=="Preferences": VerticalLayout {spacing:12px;alignment:start;
                                    Label {text:"Appearance";color:Theme.muted;font-size:Theme.font-control;font-weight:600;}
                                    SegmentedControl {model:["Light","Dark","System"];current-index:root.appearance=="light" ? 0 : root.appearance=="dark" ? 1 : 2;selected(index)=>{root.field-change("prefs.appearance",["light","dark","system"][index]);}}
                                    SettingCard {title:"Automatic recording zooms";description:"Suggest zooms when a new recording opens.";checked:root.auto-apply-zooms;toggled(v)=>{root.field-change("prefs.auto_apply_zooms",v ? "true" : "false");}}
                                    SettingCard {title:"Connect zooms";description:"Join nearby zooms into a continuous camera move.";checked:root.connect-zooms;enabled:root.has-video;toggled(v)=>{root.field-change("connectZooms",v ? "true" : "false");}}
                                    Label {text:"Motion · "+(root.motion-choice=="" ? "Custom" : root.motion-choice=="smooth" ? "Smooth" : "Focused");color:Theme.muted;font-size:Theme.font-control;font-weight:600;}
                                    MotionChoices {selected:root.motion-choice;enabled:root.has-video;picked(value)=>{root.action("motion-"+value);}}
                                    if !root.has-video: Label {text:"Open a project to adjust its motion.";color:Theme.muted;font-size:Theme.font-control;wrap:word-wrap;}
                                }
                                if root.panel=="Presets": VerticalLayout {spacing:10px;
                                    Label {text:"Choose a look";color:Theme.muted;font-size:Theme.font-control;font-weight:600;}
                                    HorizontalLayout {height:102px;spacing:6px;
                                        for look in [{key:"studio",label:"Studio",color:#171c35,radius:6px},{key:"minimal",label:"Minimal",color:#ededed,radius:2px},{key:"bold",label:"Bold",color:#54324a,radius:10px}]: ChoiceTile {height:102px;active:root.look-choice==look.key;enabled:root.has-video;label:look.label+" appearance";clicked=>{root.action("look-"+look.key);}
                                            Rectangle {x:6px;y:6px;width:parent.width - 12px;height:58px;border-radius:5px;background:look.color;
                                                Rectangle {x:10px;y:12px;width:parent.width - 20px;height:34px;border-radius:look.radius;background:#fff;border-width:1px;border-color:#00000018;}
                                            }
                                            Label {x:0px;y:66px;width:parent.width;height:30px;text:look.label;horizontal-alignment:center;}
                                        }
                                    }
                                }
                                if root.panel=="Cursor" || root.panel=="Presets": VerticalLayout {spacing:8px;
                                    Label {text:"Motion presets";color:Theme.muted;font-size:Theme.font-control;font-weight:600;}
                                    MotionChoices {selected:root.motion-choice;enabled:root.has-video;picked(value)=>{root.action("motion-"+value);}}
                                }
                                for field in root.fields: VerticalLayout {spacing:5px;vertical-stretch:0;
                                    if field.kind==5: HorizontalLayout {height:Theme.control-height;spacing:8px;
                                        Label {text:root.translate(field.label,root.language);color:Theme.muted;font-size:Theme.font-small;font-weight:600;vertical-alignment:center;}
                                        Divider {horizontal-stretch:1;}
                                    }
                                    if field.kind==0 || field.kind==4: Label {text:root.translate(field.label,root.language);color:Theme.text;font-size:Theme.font-control;wrap:word-wrap;}
                                    if field.kind==0: ValueInput {text:field.value;label:root.translate(field.label,root.language);accepted=>{root.field-change(field.key,self.text);}}
                                    if field.key=="cursorStyle": CursorChoices {selected:field.value;picked(value)=>{root.field-change(field.key,value);}}
                                    if field.key=="webcam.positionPreset": PositionChoices {selected:field.value;picked(value)=>{root.field-change(field.key,value);}}
                                    if field.key=="webcam.positionPreset": ToolButton {has-icon:false;text:"Custom position";active:field.value=="custom";clicked=>{root.field-change(field.key,"custom");}}
                                    if field.key=="cursorStyle" && field.choice>=5: Label {text:"Current: "+field.value;color:Theme.muted;font-size:Theme.font-control;}
                                    if field.kind==4 && field.key!="cursorStyle" && field.key!="webcam.positionPreset": Dropdown {label:root.translate(field.label,root.language);model:field.choices;current-index <=> field.choice;selected(value)=>{root.field-change(field.key,field.values[self.current-index]);}}
                                    if field.kind==1: ScrubField {icon:field.key=="borderRadius" ? @image-url("../assets/icons/Selection-regular.svg") : field.key=="shadowIntensity" ? @image-url("../assets/icons/Drop-regular.svg") : field.key=="zoomSmoothness" ? @image-url("../assets/icons/MagicWand-regular.svg") : @image-url("../assets/icons/SlidersHorizontal-regular.svg");label:root.translate(field.label,root.language);minimum:field.minimum;maximum:field.maximum;value:field.value.to-float();committed(value)=>{root.field-change(field.key,value);}}
                                    if field.kind==2: FieldRow {label:root.translate(field.label,root.language);
                                        Toggle {label:root.translate(field.label,root.language);checked:field.value=="true";toggled(value)=>{root.field-change(field.key,value ? "true" : "false");}}
                                    }
                                    if field.kind==3: ToolButton {has-icon:false;text:root.translate(field.value,root.language);clicked=>{root.action(field.key);}}
                                }
                            }
                        }
                        if root.panel=="Preferences": ToolButton {has-icon:false;text:"Customize keyboard shortcuts…";clicked=>{root.show-panel("Shortcuts");}}
                        if root.panel=="Recording": VerticalLayout {height:104px;spacing:8px;vertical-stretch:0;
                            Label {height:56px;vertical-alignment:center;text:root.recording-hint;wrap:word-wrap;color:Theme.muted;font-size:Theme.font-control;}
                            ToolButton {icon:@image-url("../assets/icons/Record-regular.svg");text:root.recording ? "Stop recording" : "Start recording";variant:primary;horizontal-stretch:1;enabled:!root.busy && (root.recording || root.source-names.length>0);clicked=>{root.action(root.recording ? "stop-recording" : "start-recording");}}
                        }
                        if root.panel=="Selection": ToolButton {icon:@image-url("../assets/icons/Scissors-regular.svg");text:root.translate("Delete selected region",root.language);enabled:root.selected-id!="";clicked=>{root.action("delete");}}
                        if root.panel=="Export": ToolButton {icon:@image-url("../assets/icons/Export-regular.svg");text:root.translate("Export video",root.language);variant:primary;enabled:root.has-video&&!root.busy;clicked=>{root.action("export");}}
                        if root.panel=="Captions": HorizontalLayout {spacing:6px;
                            ToolButton {has-icon:false;text:root.translate("Import SRT",root.language);clicked=>{root.action("import-captions");}}
                            ToolButton {has-icon:false;variant:primary;text:root.translate("Transcribe",root.language);clicked=>{root.action("transcribe");}}
                        }
                    }
                }
            }
            if root.has-video: Rectangle {min-height:240px;preferred-height:320px;max-height:320px;vertical-stretch:0;background:transparent;
                Panel {x:12px;width:parent.width - 24px;height:parent.height;
                    ScaleRotateGestureHandler {
                        enabled:root.has-video;
                        private property <float> initial-zoom;
                        private property <float> anchor-fraction;
                        private property <float> anchor-time;
                        started=>{
                            self.initial-zoom=root.timeline-zoom;
                            self.anchor-fraction=clamp((self.center.x - 98px)/(self.width - 120px),0,1);
                            self.anchor-time=root.timeline-offset+self.anchor-fraction*root.timeline-visible;
                        }
                        updated=>{
                            root.timeline-zoom=clamp(self.initial-zoom*self.scale,1,100);
                            root.timeline-offset=clamp(self.anchor-time - self.anchor-fraction*root.timeline-visible,0,max(0,root.duration - root.timeline-visible));
                        }
                    VerticalLayout {padding:12px;spacing:8px;
                        HorizontalLayout {height:Theme.control-height;spacing:4px;
                            IconButton {icon:@image-url("../assets/icons/MagnifyingGlassPlus-regular.svg");label:root.translate("Add zoom",root.language);variant:ghost;enabled:root.has-video;clicked=>{root.action("add-zoom");}}
                            ToolButton {icon:@image-url("../assets/icons/MagicWand-regular.svg");text:root.translate("Suggest zooms",root.language);variant:ghost;enabled:root.has-video;clicked=>{root.action("auto-zoom");}}
                            IconButton {icon:@image-url("../assets/icons/Scissors-regular.svg");label:root.translate("Split clip",root.language);variant:ghost;enabled:root.has-video;clicked=>{root.action("split-clip");}}
                            ToolButton {icon:@image-url("../assets/icons/Plus-regular.svg");text:"Add";clicked=>{add-menu.show();}
                                add-menu := PopupWindow {width:210px;y:-410px;
                                    Panel {variant:popup;
                                        VerticalLayout {padding:8px;spacing:3px;
                                            for item in [{label:"Text",action:"add-text"},{label:"Image",action:"add-image"},{label:"Arrow",action:"add-figure"},{label:"Blur",action:"add-blur"},{label:"Audio",action:"add-audio"},{label:"Caption",action:"add-caption"},{label:"Trim",action:"add-trim"},{label:"Speed",action:"add-speed"},{label:"Marker",action:"add-marker"}]: ToolButton {has-icon:false;text:item.label;horizontal-stretch:1;variant:ghost;clicked=>{root.action(item.action);add-menu.close();}}
                                        }
                                    }
                                }
                            }
                            Rectangle {horizontal-stretch:1;}
                            IconButton {icon:@image-url("../assets/icons/Magnet-regular.svg");label:root.translate("Snap",root.language);variant:ghost;active:root.snap;clicked=>{root.snap=!root.snap;}}
                            IconButton {icon:@image-url("../assets/icons/ArrowsOutSimple-regular.svg");label:root.translate("Fit timeline",root.language);variant:ghost;clicked=>{root.timeline-zoom=1;root.timeline-offset=0;}}
                            FineSlider {width:160px;filled:true;endpoint-icons:true;minimum-icon:@image-url("../assets/icons/MagnifyingGlassMinus-regular.svg");maximum-icon:@image-url("../assets/icons/MagnifyingGlassPlus-regular.svg");minimum:1;maximum:100;label:root.translate("Timeline zoom",root.language);value:root.timeline-zoom;changed(value)=>{root.timeline-zoom=value;}released(value)=>{root.timeline-zoom=value;}}
                        }
                        Rectangle {min-height:64px;preferred-height:92px;max-height:92px;clip:true;
                            Label {x:8px;y:48px;height:20px;text:root.translate("Source",root.language);color:Theme.muted;font-size:9px;}
                            Rectangle {x:86px;width:parent.width - 96px;height:parent.height;clip:true;
                                for i in 8: Label {x:i/8*parent.width;y:0px;text:round((root.timeline-offset+root.timeline-visible*i/8)*10)/10+"s";color:Theme.muted;font-size:Theme.font-small;}
                                Rectangle {y:24px;height:parent.height - 24px;border-radius:12px;background:Theme.track;clip:true;
                                    Label {x:12px;y:3px;width:parent.width - 24px;height:18px;text:root.document-title;color:Theme.muted;font-size:Theme.font-small;overflow:elide;}
                                    Image {x:-root.timeline-offset/root.timeline-visible*parent.width;y:24px;width:parent.width*root.timeline-zoom;height:parent.height - 24px;source:root.thumbnails;image-fit:fill;}
                                }

                                TouchArea {mouse-cursor:ew-resize;
                                    pointer-event(e)=>{if e.kind==PointerEventKind.down && e.button==PointerEventButton.left {root.seek(root.timeline-offset+clamp(self.mouse-x/self.width,0,1)*root.timeline-visible);}if e.kind==PointerEventKind.up && e.button==PointerEventButton.left {root.seek(root.timeline-offset+clamp(self.mouse-x/self.width,0,1)*root.timeline-visible);}}
                                    moved=>{if self.pressed {root.seek(root.timeline-offset+clamp(self.mouse-x/self.width,0,1)*root.timeline-visible);}}
                                }
                            }
                        }
                        ScrollArea {vertical-stretch:1;viewport-height:root.track-labels.length*44px;viewport-width:self.width;
                        timeline:=Rectangle {width:parent.width;height:root.track-labels.length*44px;
                            for label[i] in root.track-labels: Label {x:8px;y:i*44px+15px;text:root.translate(label,root.language);color:Theme.muted;font-size:9px;}
                            tracks:=Rectangle {x:86px;width:parent.width - 96px;height:parent.height;clip:true;
                                for i in root.track-labels.length: Rectangle {y:i*44px;height:38px;border-radius:12px;background:Theme.track.with-alpha(0.4);}

                                Image {x:-root.timeline-offset/root.timeline-visible*parent.width;y:root.audio-row*44px;width:parent.width*root.timeline-zoom;height:38px;source:root.waveform;image-fit:fill;opacity:0.25;}
                                TouchArea {pointer-event(e)=>{if e.kind==PointerEventKind.down {root.seek(root.timeline-offset+self.mouse-x/self.width*root.timeline-visible);}}moved=>{if self.pressed {root.seek(root.timeline-offset+self.mouse-x/self.width*root.timeline-visible);}}}
                                for region in root.regions: Rectangle {x:(region.start - root.timeline-offset)/root.timeline-visible*parent.width;y:region.row*44px+1px;width:max(8px,(region.end - region.start)/root.timeline-visible*parent.width);height:36px;border-radius:11px;background:region.tint.with-alpha(region.selected ? 0.24 : 0.11);border-width:1px;border-color:region.selected ? region.tint.with-alpha(0.6) : transparent;
                                    Label {x:9px;width:parent.width - 18px;text:region.label;color:Theme.text;font-size:Theme.font-small;overflow:elide;vertical-alignment:center;}
                                    TouchArea {private property <length> origin;pointer-event(e)=>{if e.kind==PointerEventKind.down {self.origin=self.mouse-x;root.select-region(region.kind,region.id,e.modifiers.shift);}if e.kind==PointerEventKind.up {root.move-region(region.kind,region.id,(self.mouse-x - self.origin)/tracks.width*root.timeline-visible,0);}}}
                                    Rectangle {x:0px;width:10px;height:parent.height;
                                        Rectangle {x:3px;y:10px;width:4px;height:16px;border-radius:2px;background:region.tint.with-alpha(0.55);}
                                        TouchArea {mouse-cursor:ew-resize;private property <length> origin;pointer-event(e)=>{if e.kind==PointerEventKind.down {self.origin=self.mouse-x;root.select-region(region.kind,region.id,e.modifiers.shift);}if e.kind==PointerEventKind.up {root.move-region(region.kind,region.id,(self.mouse-x - self.origin)/tracks.width*root.timeline-visible,2);}}}
                                    }
                                    Rectangle {x:parent.width - 10px;width:10px;height:parent.height;
                                        Rectangle {x:3px;y:10px;width:4px;height:16px;border-radius:2px;background:region.tint.with-alpha(0.55);}
                                        TouchArea {mouse-cursor:ew-resize;private property <length> origin;pointer-event(e)=>{if e.kind==PointerEventKind.down {self.origin=self.mouse-x;root.select-region(region.kind,region.id,e.modifiers.shift);}if e.kind==PointerEventKind.up {root.move-region(region.kind,region.id,(self.mouse-x - self.origin)/tracks.width*root.timeline-visible,1);}}}
                                    }
                                }

                            }
                        }
                        }
                        FineSlider {progress-style:true;minimum:0;maximum:max(0.001,root.duration - root.timeline-visible);value:root.timeline-offset;changed(value)=>{root.timeline-offset=value;}released(value)=>{root.timeline-offset=value;}label:root.translate("Timeline position",root.language);}
                    }
                    TimelineScrubber {
                        backdrop:root.frosted-thumbnails;
                        backdrop-width:(parent.width - 120px)*root.timeline-zoom;
                        backdrop-offset:root.playhead/root.duration*self.backdrop-width;

                        x:98px+(root.playhead - root.timeline-offset)/root.timeline-visible*(parent.width - 120px) - self.width/2;
                        y:56px;height:parent.height - 108px;
                        visible:root.playhead>=root.timeline-offset && root.playhead<=root.timeline-offset+root.timeline-visible;
                        scrubbed(delta)=>{root.seek(clamp(root.playhead+delta/(parent.width - 120px)*root.timeline-visible,0,root.duration));}
                    }
                    }
                }
            }
            Rectangle {height:root.busy ? 52px : 24px;
                VerticalLayout {padding-left:20px;padding-right:20px;spacing:2px;
                    HorizontalLayout {Label {text:root.status;color:#85858f;font-size:Theme.font-small;overflow:elide;vertical-alignment:center;horizontal-stretch:1;}if root.busy: ToolButton {size:small;has-icon:false;text:root.translate("Cancel",root.language);clicked=>{root.action("cancel");}}}
                    if root.busy: ProgressBar {progress:root.progress;}
                }
            }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    tooltip: "SubTake";
    icon: @image-url("../legacy-electron/public/rec-button.png");
    in property <bool> recording: false;
    callback action(string);
    Menu {
        MenuItem {title:"Open";activated=>{root.action("show");}}
        MenuItem {title:"Quit";activated=>{root.action("quit");}}
    }
}
export component RecordingLauncher inherits Window {
    title: "SubTake recorder";
    in property <length> bar-width: 692px;
    width: root.bar-width + 32px;
    height: 80px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-body;
    in property <string> appearance: "system";
    in-out property <string> panel;
    in property <[string]> source-names;
    in-out property <int> source-index;
    in property <[string]> camera-names;
    in property <[string]> microphone-names;
    in-out property <int> camera-index;
    in-out property <int> microphone-index;
    in property <bool> camera;
    in property <bool> microphone;
    in property <bool> system-audio;
    in property <bool> busy;
    in property <bool> recording;
    in property <bool> paused;
    in property <bool> has-project;
    in property <bool> cancellable;
    in property <string> status;
    in property <string> elapsed: "00:00";
    in property <string> directory;
    in property <int> countdown: 3;
    callback action(string);
    callback panel-change(string);
    function toggle-panel(name: string) { root.panel = root.panel == name ? "" : name; root.panel-change(root.panel); }
    function begin-recording() { if root.source-names.length == 0 { root.toggle-panel("sources"); root.action("sources"); } else { root.action("start-recording"); } }
    init => { Palette.color-scheme = root.appearance == "light" ? ColorScheme.light : root.appearance == "dark" ? ColorScheme.dark : ColorScheme.unknown; }
    changed appearance => { Palette.color-scheme = root.appearance == "light" ? ColorScheme.light : root.appearance == "dark" ? ColorScheme.dark : ColorScheme.unknown; }

    Panel {
        variant: overlay;
        x: 16px;
        y: 8px;
        width: root.bar-width;
        height: 64px;
        HorizontalLayout {
            padding: 12px;
            spacing: 8px;
            Rectangle { width: 20px; height: 40px;
                Image { x: 2px; y: 12px; width: 16px; height: 16px; source: @image-url("../assets/icons/DotsSixVertical-regular.svg"); colorize: Theme.muted; }
                TouchArea { mouse-cursor: move; pointer-event(e) => { if e.kind == PointerEventKind.down { root.action("drag-launcher"); } } }
            }
            if !root.recording && !root.busy: HorizontalLayout {
                spacing: 8px;
                AppMark {}
                ToolButton { size: large; width: 190px; icon: @image-url("../assets/icons/Monitor-regular.svg"); text: root.source-names.length > 0 ? root.source-names[root.source-index] : "Choose a source"; label: "Screens and windows"; active: root.panel == "sources"; clicked => { root.toggle-panel("sources"); } }
                Rectangle { width: 1px; Rectangle { y: 7px; height: 26px; width: 1px; background: Theme.border; } }
                IconButton { size: large; icon: root.microphone ? @image-url("../assets/icons/Microphone-regular.svg") : @image-url("../assets/icons/MicrophoneSlash-regular.svg"); label: "Microphone & system audio"; active: root.microphone || root.system-audio; variant: ghost; clicked => { root.toggle-panel("audio"); } }
                IconButton { size: large; icon: root.camera ? @image-url("../assets/icons/VideoCamera-regular.svg") : @image-url("../assets/icons/VideoCameraSlash-regular.svg"); label: "Webcam"; active: root.camera; variant: ghost; clicked => { root.toggle-panel("camera"); } }
                IconButton { size: large; icon: @image-url("../assets/icons/Timer-regular.svg"); label: "Countdown delay"; active: root.countdown > 0; variant: ghost; clicked => { root.toggle-panel("countdown"); } }
                RecordButton { clicked => { root.begin-recording(); } }
                IconButton { size: large; icon: @image-url("../assets/icons/DotsThree-regular.svg"); label: "More options"; variant: ghost; clicked => { root.toggle-panel("more"); } }
            }
            if root.recording || root.busy: HorizontalLayout {
                spacing: 10px;
                Rectangle { width: 8px; Rectangle { y: 16px; width: 8px; height: 8px; border-radius: 4px; background: root.paused ? #e8b251 : #f43f5e; } }
                Label { text: root.recording ? (root.paused ? "PAUSED  " : "REC  ") + root.elapsed : root.status; horizontal-stretch: 1; color: Theme.text; vertical-alignment: center; overflow: elide; }
                if root.recording: ToolButton { size: large; icon: root.paused ? @image-url("../assets/icons/Play-fill.svg") : @image-url("../assets/icons/Pause-fill.svg"); text: root.paused ? "Resume" : "Pause"; enabled: !root.busy; clicked => { root.action("pause-recording"); } }
                if root.recording: ToolButton { size: large; icon: @image-url("../assets/icons/Stop-fill.svg"); text: "Stop"; icon-color: #f43f5e; enabled: !root.busy; clicked => { root.action("stop-recording"); } }
                if root.cancellable: ToolButton { size: large; has-icon: false; text: "Cancel"; clicked => { root.action("cancel"); } }
            }
            IconButton { size: large; icon: @image-url("../assets/icons/Question-regular.svg"); label: root.status; variant: ghost; }
            IconButton { size: large; icon: @image-url("../assets/icons/X-regular.svg"); label: "Close overlay — reopen from the menu bar"; variant: ghost; clicked => { root.action("hide-launcher"); } }
        }
    }
}

export component RecordingOptions inherits Window {
    title: "SubTake recorder options";
    in property <length> options-width: root.panel == "more" ? 520px : root.panel == "sources" ? 430px : root.panel == "audio" ? 420px : root.panel == "camera" ? 420px : 400px;
    in property <length> options-height: root.panel == "more" ? 284px : root.panel == "camera" ? 276px : 264px;
    width: root.options-width;
    height: root.options-height;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-body;
    in property <string> appearance: "system";
    in property <string> panel;
    in property <[string]> source-names;
    in-out property <int> source-index;
    in property <[string]> camera-names;
    in property <[string]> microphone-names;
    in-out property <int> camera-index;
    in-out property <int> microphone-index;
    in property <bool> camera;
    in property <bool> microphone;
    in property <bool> system-audio;
    in property <bool> busy;
    in property <bool> has-project;
    in property <string> directory;
    in property <int> countdown: 3;
    callback action(string);
    callback option(string, string);
    callback panel-change(string);
    init => { Palette.color-scheme = root.appearance == "light" ? ColorScheme.light : root.appearance == "dark" ? ColorScheme.dark : ColorScheme.unknown; }
    changed appearance => { Palette.color-scheme = root.appearance == "light" ? ColorScheme.light : root.appearance == "dark" ? ColorScheme.dark : ColorScheme.unknown; }
    Panel { variant: overlay; width: parent.width; height: parent.height;
        VerticalLayout { padding: 20px; spacing: 12px;
            HorizontalLayout { height: Theme.control-height;
                Label { text: root.panel == "sources" ? "Screens and windows" : root.panel == "audio" ? "Microphone & system audio" : root.panel == "camera" ? "Webcam" : root.panel == "countdown" ? "Countdown delay" : "More"; color: Theme.text; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                IconButton { size: small; icon: @image-url("../assets/icons/X-regular.svg"); label: "Close options"; variant: ghost; clicked => { root.panel-change(""); } }
            }
            if root.panel == "sources": VerticalLayout { spacing: 10px; alignment: start;
                Dropdown { label: "Capture source"; enabled: !root.busy; model: root.source-names; current-index <=> root.source-index; horizontal-stretch: 1; selected(value) => { root.option("source", self.current-index); } }
                Label { text: "Choose a display or a visible window to record."; role: muted; horizontal-stretch: 1; wrap: word-wrap; min-height: 32px; }
                ToolButton { icon: @image-url("../assets/icons/ArrowClockwise-regular.svg"); text: "Refresh displays and windows"; enabled: !root.busy; horizontal-stretch: 1; clicked => { root.action("sources"); } }
            }
            if root.panel == "audio": VerticalLayout { spacing: 8px; alignment: start;
                HorizontalLayout { height: Theme.control-height; Label { text: "Microphone"; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; } Toggle { checked: root.microphone; label: "Microphone"; toggled(value) => { root.option("microphone", value ? "true" : "false"); } } }
                Dropdown { label: "Microphone"; enabled: !root.busy && root.microphone; model: root.microphone-names; current-index <=> root.microphone-index; horizontal-stretch: 1; selected(value) => { root.option("microphone-device", self.current-index); } }
                HorizontalLayout { height: Theme.control-height; Label { text: "System audio"; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; } Toggle { checked: root.system-audio; label: "System audio"; toggled(value) => { root.option("system-audio", value ? "true" : "false"); } } }
            }
            if root.panel == "camera": VerticalLayout { spacing: 10px; alignment: start;
                HorizontalLayout { height: Theme.control-height; Label { text: "Webcam overlay"; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; } Toggle { checked: root.camera; label: "Webcam overlay"; toggled(value) => { root.option("camera", value ? "true" : "false"); } } }
                Dropdown { label: "Camera"; enabled: !root.busy && root.camera; model: root.camera-names; current-index <=> root.camera-index; horizontal-stretch: 1; selected(value) => { root.option("camera-device", self.current-index); } }
                Label { text: "Your camera is recorded separately and added to the project."; role: muted; horizontal-stretch: 1; wrap: word-wrap; min-height: 40px; }
            }
            if root.panel == "countdown": VerticalLayout { spacing: 14px; alignment: start;
                Label { text: "Give yourself a moment before recording starts."; color: Theme.muted; height: 24px; }
                SegmentedControl { model: ["No delay", "3 seconds", "5 seconds", "10 seconds"]; current-index: root.countdown == 0 ? 0 : root.countdown == 3 ? 1 : root.countdown == 5 ? 2 : 3; selected(index) => { root.option("countdown", [0, 3, 5, 10][index]); } }
            }
            if root.panel == "more": VerticalLayout { spacing: 10px; alignment: start;
                ToolButton { size: regular; icon: @image-url("../assets/icons/Sparkle-regular.svg"); text: "Create video · spike"; horizontal-stretch: 1; clicked => { root.action("storyboard-spike"); } }
                HorizontalLayout { spacing: 8px; height: Theme.control-height;
                    ToolButton { icon: @image-url("../assets/icons/FolderOpen-regular.svg"); text: "Open video or project"; horizontal-stretch: 1; clicked => { root.action("open"); } }
                    ToolButton { icon: @image-url("../assets/icons/Stack-regular.svg"); text: "Projects"; horizontal-stretch: 1; clicked => { root.action("projects"); } }
                    ToolButton { icon: @image-url("../assets/icons/FilmStrip-regular.svg"); text: "Back to editor"; enabled: root.has-project; horizontal-stretch: 1; clicked => { root.action("show-editor"); } }
                }
                Label { text: "Recordings path"; role: muted; height: 18px; }
                HorizontalLayout { height: Theme.control-height; spacing: 10px; Label { text: root.directory; color: Theme.text; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; } ToolButton { has-icon: false; text: "Choose folder…"; clicked => { root.action("recording-folder"); } } }
            }
        }
    }
}
