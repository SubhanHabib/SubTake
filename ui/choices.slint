import { Theme, ToolButton, Toggle, ChoiceTile, Panel, Label } from "controls.slint";

export component SettingCard inherits Panel {
    in property <string> title;
    in property <string> description;
    in property <bool> checked;
    in property <bool> enabled:true;
    callback toggled(bool);
    height:80px;variant:card;
    opacity:root.enabled ? 1 : 0.45;
    HorizontalLayout {padding:12px;spacing:12px;
        VerticalLayout {spacing:5px;alignment:center;
            Label {text:root.title;color:Theme.text;font-size:Theme.font-body;font-weight:600;wrap:word-wrap;}
            Label {text:root.description;color:Theme.muted;font-size:Theme.font-control;wrap:word-wrap;}
        }
        VerticalLayout {width:30px;alignment:center;
            Toggle {enabled:root.enabled;label:root.title;checked:root.checked;toggled(v)=>{if root.enabled {root.toggled(v);}}}
        }
    }
}

export component MotionChoices inherits Rectangle {
    in property <string> selected;
    in property <bool> enabled:true;
    callback picked(string);
    height:140px;
    HorizontalLayout {spacing:8px;
        for choice in [{key:"focused",title:"Focused",description:"Snappy moves for demos",smooth:false},{key:"smooth",title:"Smooth",description:"Gentle moves for stories",smooth:true}]: ChoiceTile {
            height:140px;active:root.selected==choice.key;enabled:root.enabled;label:choice.title+" - "+choice.description;clicked=>{root.picked(choice.key);}
            VerticalLayout {padding:10px;spacing:6px;
                Rectangle {height:54px;border-radius:6px;background:Theme.bg;
                    Rectangle {x:10px;y:12px;width:parent.width - 20px;height:30px;border-radius:choice.smooth ? 12px : 3px;border-width:1px;border-color:Theme.muted;}
                    Rectangle {x:choice.smooth ? 18px : parent.width - 34px;y:20px;width:16px;height:16px;border-radius:8px;background:Theme.blue;}
                    Rectangle {x:choice.smooth ? 38px : 18px;y:27px;width:choice.smooth ? parent.width - 54px : 16px;height:2px;background:Theme.blue.with-alpha(0.45);}
                }
                Label {text:choice.title;color:Theme.text;font-size:Theme.font-body;font-weight:600;}
                Label {text:choice.description;color:Theme.muted;font-size:Theme.font-control;wrap:word-wrap;}
            }
        }
    }
}

export component CursorChoices inherits Rectangle {
    in property <string> selected;
    callback picked(string);
    height:154px;
    for choice[i] in [
        {key:"tahoe",label:"Tahoe",image:@image-url("../legacy-electron/src/assets/cursors/tahoe/pointer-1__14-6.svg")},
        {key:"macos",label:"macOS",image:@image-url("../legacy-electron/src/assets/cursors/macos/pointer-1__34-24.svg")},
        {key:"windows11",label:"Windows",image:@image-url("../legacy-electron/src/assets/cursors/windows11/arrow__31-22.svg")},
        {key:"dot",label:"Dot",image:@image-url("../assets/icons/Record-fill.svg")},
        {key:"figma",label:"Minimal",image:@image-url("../legacy-electron/src/assets/cursors/custom/minimal-cursor.svg")}
    ]: ChoiceTile {
        x:mod(i,3)*(parent.width+6px)/3;y:floor(i/3)*80px;width:(parent.width - 12px)/3;height:74px;
        active:root.selected==choice.key;label:choice.label+" cursor";clicked=>{root.picked(choice.key);}
        Rectangle {x:8px;y:6px;width:parent.width - 16px;height:40px;border-radius:5px;background:#e7e9ee;
            Image {x:(parent.width - 28px)/2;y:6px;width:28px;height:28px;source:choice.image;image-fit:contain;}
        }
        Label {x:0px;y:46px;width:parent.width;height:26px;text:choice.label;horizontal-alignment:center;}
    }
}

export component PositionChoices inherits Rectangle {
    in property <string> selected;
    callback picked(string);
    height:126px;
    for cell[i] in ["top-left","top-center","top-right","center-left","center","center-right","bottom-left","bottom-center","bottom-right"]: ChoiceTile {
        x:mod(i,3)*(parent.width+6px)/3;y:floor(i/3)*44px;width:(parent.width - 12px)/3;height:38px;
        active:root.selected==cell;label:"Webcam position "+cell;clicked=>{root.picked(cell);}
        Rectangle {x:8px+mod(i,3)*(parent.width - 26px)/2;y:6px+floor(i/3)*8px;width:10px;height:10px;border-radius:3px;background:root.selected==cell ? Theme.blue : Theme.muted;}
    }
}
